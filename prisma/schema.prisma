// SGS - Sistema de Gestão em Segurança do Trabalho
// Schema Prisma — PostgreSQL (produção Vercel + Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPRESA
  CLINICA
  MEDICO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(EMPRESA)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  empresa   Empresa?  @relation(fields: [empresaId], references: [id])
  empresaId String?
  clinica   Clinica?  @relation(fields: [clinicaId], references: [id])
  clinicaId String?
  medico    Medico?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Empresa {
  id                   String   @id @default(cuid())
  razaoSocial          String
  nomeFantasia         String?
  cnpj                 String   @unique
  inscricaoEstadual    String?
  endereco             String?
  cidade               String?
  uf                   String?
  cep                  String?
  telefone             String?
  email                String?
  grauRisco            Int?
  cnae                 String?
  numeroFuncionarios   Int?
  logoUrl              String?  @db.Text
  pastaTreinamentosUrl String?
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                User[]
  setores              Setor[]
  colaboradores        Colaborador[]
  pgrs                 PGR[]
  pcmso                PCMSO[]
  solicitacoesExame    SolicitacaoExame[]
  treinamentos         Treinamento[]
  materiaisTreinamento MaterialTreinamento[]
  cats                 CAT[]
  permissoesTrabalho   PermissaoTrabalho[]
  pets                 PET[]
  ppps                 PPP[]
}

model Clinica {
  id           String   @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String   @unique
  endereco     String?
  cidade       String?
  uf           String?
  cep          String?
  telefone     String?
  email        String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users             User[]
  medicos           Medico[]
  solicitacoesExame SolicitacaoExame[]
  asos              ASO[]
}

model Medico {
  id            String   @id @default(cuid())
  nome          String
  crm           String
  crmUf         String
  especialidade String?
  telefone      String?
  email         String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User?   @relation(fields: [userId], references: [id])
  userId    String? @unique
  clinica   Clinica @relation(fields: [clinicaId], references: [id])
  clinicaId String

  pcmsoCoordenados PCMSO[] @relation("MedicoCoordenador")
  asosEmitidos     ASO[]
}

model Setor {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funcoes       Funcao[]
  ghes          GHE[]
  colaboradores Colaborador[]
}

model Funcao {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  cbo       String?
  setor     Setor    @relation(fields: [setorId], references: [id], onDelete: Cascade)
  setorId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colaboradores Colaborador[]
  riscos        RiscoFuncao[]
}

model Colaborador {
  id             String    @id @default(cuid())
  nome           String
  cpf            String
  dataNascimento DateTime?
  sexo           String?
  email          String?
  telefone       String?
  dataAdmissao   DateTime?
  dataDemissao   DateTime?
  fotoUrl        String?   @db.Text
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String
  setor     Setor?  @relation(fields: [setorId], references: [id])
  setorId   String?
  funcao    Funcao? @relation(fields: [funcaoId], references: [id])
  funcaoId  String?

  solicitacoesExame        SolicitacaoExame[]
  asos                     ASO[]
  treinamentosParticipante TreinamentoParticipante[]
  cats                     CAT[]
  permissoesTrabalho       PermissaoTrabalho[]
  pets                     PET[]
  ppps                     PPP[]

  @@unique([empresaId, cpf])
}

enum TipoRisco {
  FISICO
  QUIMICO
  BIOLOGICO
  ERGONOMICO
  ACIDENTE
  PSICOSSOCIAL
}

enum NivelRisco {
  BAIXO
  MEDIO
  ALTO
  MUITO_ALTO
}

model Risco {
  id               String    @id @default(cuid())
  nome             String
  tipo             TipoRisco
  descricao        String?
  fonteGeradora    String?
  possiveisAgravos String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  funcoes         RiscoFuncao[]
  ghes            RiscoGHE[]
  inventarioItens InventarioRiscoItem[]
  examesPCMSO     ExamePCMSO[]
}

model RiscoFuncao {
  id                String      @id @default(cuid())
  risco             Risco       @relation(fields: [riscoId], references: [id], onDelete: Cascade)
  riscoId           String
  funcao            Funcao      @relation(fields: [funcaoId], references: [id], onDelete: Cascade)
  funcaoId          String
  nivelRisco        NivelRisco?
  probabilidade     Int?
  severidade        Int?
  medidasExistentes String?

  @@unique([riscoId, funcaoId])
}

model GHE {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  setor     Setor    @relation(fields: [setorId], references: [id], onDelete: Cascade)
  setorId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riscos RiscoGHE[]
}

model RiscoGHE {
  id            String      @id @default(cuid())
  ghe           GHE         @relation(fields: [gheId], references: [id], onDelete: Cascade)
  gheId         String
  risco         Risco       @relation(fields: [riscoId], references: [id], onDelete: Cascade)
  riscoId       String
  nivelRisco    NivelRisco?
  probabilidade Int?
  severidade    Int?

  @@unique([gheId, riscoId])
}

enum StatusDocumento {
  RASCUNHO
  EM_REVISAO
  APROVADO
  VENCIDO
}

model PGR {
  id                      String          @id @default(cuid())
  titulo                  String
  versao                  String          @default("1.0")
  dataElaboracao          DateTime        @default(now())
  dataRevisao             DateTime?
  status                  StatusDocumento @default(RASCUNHO)
  elaboradorNome          String?
  elaboradorRegistro      String?
  observacoes             String?
  caracterizacaoProcessos String?
  metodologiaAvaliacao    String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId       String
  inventarioItens InventarioRiscoItem[]
  planoAcaoItens  PlanoAcaoItem[]
  pcmso           PCMSO?
}

model InventarioRiscoItem {
  id                               String      @id @default(cuid())
  pgr                              PGR         @relation(fields: [pgrId], references: [id], onDelete: Cascade)
  pgrId                            String
  risco                            Risco       @relation(fields: [riscoId], references: [id])
  riscoId                          String
  setorNome                        String?
  funcaoNome                       String?
  gheNome                          String?
  fonteGeradora                    String?
  numeroExpostos                   Int?
  tipoExposicao                    String?
  probabilidade                    Int?
  severidade                       Int?
  nivelRisco                       NivelRisco?
  medidasExistentes                String?
  necessidadeAvaliacaoQuantitativa Boolean     @default(false)
  resultadoAvaliacao               String?
  observacoes                      String?
  createdAt                        DateTime    @default(now())
  updatedAt                        DateTime    @updatedAt
}

model PlanoAcaoItem {
  id               String    @id @default(cuid())
  pgr              PGR       @relation(fields: [pgrId], references: [id], onDelete: Cascade)
  pgrId            String
  descricaoAcao    String
  riscoRelacionado String?
  responsavel      String?
  prazo            DateTime?
  status           String    @default("Pendente")
  prioridade       String?
  observacoes      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PCMSO {
  id              String          @id @default(cuid())
  titulo          String
  versao          String          @default("1.0")
  dataElaboracao  DateTime        @default(now())
  dataRevisao     DateTime?
  status          StatusDocumento @default(RASCUNHO)
  objetivos       String?
  diretrizes      String?
  responsavelNome String?
  responsavelCrm  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  empresa             Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId           String
  pgr                 PGR?         @relation(fields: [pgrId], references: [id])
  pgrId               String?      @unique
  medicoCoordenador   Medico?      @relation("MedicoCoordenador", fields: [medicoCoordenadorId], references: [id])
  medicoCoordenadorId String?
  exames              ExamePCMSO[]
}

model ExamePCMSO {
  id                     String   @id @default(cuid())
  pcmso                  PCMSO    @relation(fields: [pcmsoId], references: [id], onDelete: Cascade)
  pcmsoId                String
  nomeExame              String
  tipo                   String
  periodicidade          String?
  risco                  Risco?   @relation(fields: [riscoId], references: [id])
  riscoId                String?
  setoresAplicaveis      String?
  funcoesAplicaveis      String?
  criteriosInterpretacao String?
  observacoes            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum StatusSolicitacao {
  PENDENTE
  ENVIADA_CLINICA
  EM_ATENDIMENTO
  ASO_EMITIDO
  CANCELADA
}

model SolicitacaoExame {
  id                String            @id @default(cuid())
  tipoExame         String
  status            StatusSolicitacao @default(PENDENTE)
  dataSolicitacao   DateTime          @default(now())
  dataAgendamento   DateTime?
  observacoes       String?
  riscosInformados  String?
  examesSolicitados String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  empresa       Empresa     @relation(fields: [empresaId], references: [id])
  empresaId     String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  colaboradorId String
  clinica       Clinica?    @relation(fields: [clinicaId], references: [id])
  clinicaId     String?
  aso           ASO?
}

model ASO {
  id                    String   @id @default(cuid())
  numero                String?
  dataEmissao           DateTime @default(now())
  dataExame             DateTime?
  razaoSocialEmpresa    String
  cnpjEmpresa           String
  nomeColaborador       String
  cpfColaborador        String
  funcaoColaborador     String?
  riscosOcupacionais    String?
  examesRealizados      String?
  conclusao             String
  restricoes            String?
  medicoNome            String?
  medicoCrm             String?
  medicoCrmUf           String?
  medicoCoordNome       String?
  medicoCoordCrm        String?
  arquivoUrl            String?
  observacoes           String?
  checklistPsicossocial String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  solicitacao   SolicitacaoExame @relation(fields: [solicitacaoId], references: [id])
  solicitacaoId String           @unique
  colaborador   Colaborador      @relation(fields: [colaboradorId], references: [id])
  colaboradorId String
  clinica       Clinica          @relation(fields: [clinicaId], references: [id])
  clinicaId     String
  medico        Medico?          @relation(fields: [medicoId], references: [id])
  medicoId      String?
}

model Treinamento {
  id             String    @id @default(cuid())
  titulo         String
  tipo           String
  catalogoId     String?
  cargaHoraria   Int?
  dataRealizacao DateTime?
  validade       DateTime?
  instrutor      String?
  local          String?
  conteudo       String?
  observacoes    String?
  materialUrl    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  empresa       Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  participantes TreinamentoParticipante[]
}

model TreinamentoParticipante {
  id            String   @id @default(cuid())
  presente      Boolean  @default(true)
  nota          String?
  certificado   String?
  createdAt     DateTime @default(now())

  treinamento   Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  treinamentoId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  colaboradorId String

  @@unique([treinamentoId, colaboradorId])
}

model MaterialTreinamento {
  id         String   @id @default(cuid())
  catalogoId String
  titulo     String
  norma      String?
  url        String
  descricao  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String

  @@unique([empresaId, catalogoId])
}

// ==================== CAT / PT / PET / PPP ====================

enum TipoCAT {
  INICIAL
  REABERTURA
  COMUNICACAO_OBITO
}

enum StatusOperacional {
  RASCUNHO
  EMITIDO
  ENCERRADO
  CANCELADO
}

/// Comunicação de Acidente de Trabalho (INSS / eSocial)
model CAT {
  id                String           @id @default(cuid())
  tipo              TipoCAT          @default(INICIAL)
  status            StatusOperacional @default(RASCUNHO)
  numeroCat         String?
  dataAcidente      DateTime
  horaAcidente      String?
  localAcidente     String?
  descricao         String
  parteCorpoAtingida String?
  agenteCausador    String?
  houveAfastamento  Boolean          @default(false)
  dataObito         DateTime?
  testemunhas       String?
  observacoes       String?
  emitidoPor        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  colaboradorId String
}

enum TipoPermissao {
  PT_GERAL
  PT_ALTURA
  PT_QUENTE
  PT_ELETRICA
  PT_OUTRA
}

/// Permissão de Trabalho (PT)
model PermissaoTrabalho {
  id              String           @id @default(cuid())
  numero          String?
  tipo            TipoPermissao    @default(PT_GERAL)
  status          StatusOperacional @default(RASCUNHO)
  local           String
  atividade       String
  dataInicio      DateTime
  dataFim         DateTime?
  riscos          String?
  epiNecessario   String?
  medidasControle String?
  observacoes     String?
  autorizadoPor   String?
  executanteNome  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id])
  colaboradorId String?
}

/// Permissão de Entrada e Trabalho — espaço confinado (NR-33)
model PET {
  id                    String            @id @default(cuid())
  numero                String?
  status                StatusOperacional @default(RASCUNHO)
  identificacaoEspaco   String
  local                 String
  atividade             String
  dataEntrada           DateTime
  dataSaidaPrevista     DateTime?
  dataEncerramento      DateTime?
  atmosfera             String?
  oxigenioPercentual    String?
  gasesMedidos          String?
  ventilacao            String?
  epiEpc                String?
  riscosAdicionais      String?
  procedimentosEntrada  String?
  procedimentosEmergencia String?
  supervisorNome        String?
  vigiaNome             String?
  trabalhadoresNomes    String?
  observacoes           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id])
  colaboradorId String?
}

/// Perfil Profissiográfico Previdenciário (base para emissão / arquivo)
model PPP {
  id                 String   @id @default(cuid())
  status             StatusOperacional @default(RASCUNHO)
  nit                String?
  ctpsNumero         String?
  ctpsSerie          String?
  dataAdmissao       DateTime?
  dataDemissao       DateTime?
  lotacao            String?
  descricaoAtividades String? @db.Text
  fatoresRisco       String?  @db.Text
  profissionalResponsavel String?
  registroProfissional    String?
  observacoes        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  colaboradorId String

  periodos PPPPeriodo[]
}

model PPPPeriodo {
  id              String    @id @default(cuid())
  dataInicio      DateTime
  dataFim         DateTime?
  cargoFuncao     String?
  setor           String?
  fatoresRisco    String?
  intensidade     String?
  tecnicaUtilizada String?
  epcEficaz       Boolean?
  epiEficaz       Boolean?
  observacoes     String?

  ppp   PPP    @relation(fields: [pppId], references: [id], onDelete: Cascade)
  pppId String
}
