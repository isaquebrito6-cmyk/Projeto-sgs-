// SGS - Sistema de Gestão em Segurança do Trabalho
// Schema Prisma — PostgreSQL (produção Vercel + Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

enum Role {
  ADMIN
  EMPRESA
  CLINICA
  MEDICO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(EMPRESA)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  empresa       Empresa?  @relation(fields: [empresaId], references: [id])
  empresaId     String?
  clinica       Clinica?  @relation(fields: [clinicaId], references: [id])
  clinicaId     String?
  medico        Medico?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== EMPRESAS E CLÍNICAS ====================

model Empresa {
  id                 String   @id @default(cuid())
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String   @unique
  inscricaoEstadual  String?
  endereco           String?
  cidade             String?
  uf                 String?
  cep                String?
  telefone           String?
  email              String?
  grauRisco          Int?
  cnae               String?
  numeroFuncionarios Int?
  logoUrl            String?
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users              User[]
  setores            Setor[]
  colaboradores      Colaborador[]
  pgrs               PGR[]
  pcmso              PCMSO[]
  solicitacoesExame  SolicitacaoExame[]
  treinamentos       Treinamento[]
}

model Clinica {
  id           String   @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String   @unique
  endereco     String?
  cidade       String?
  uf           String?
  cep          String?
  telefone     String?
  email        String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users             User[]
  medicos           Medico[]
  solicitacoesExame SolicitacaoExame[]
  asos              ASO[]
}

model Medico {
  id            String   @id @default(cuid())
  nome          String
  crm           String
  crmUf         String
  especialidade String?
  telefone      String?
  email         String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user              User?   @relation(fields: [userId], references: [id])
  userId            String? @unique
  clinica           Clinica @relation(fields: [clinicaId], references: [id])
  clinicaId         String

  pcmsoCoordenados PCMSO[] @relation("MedicoCoordenador")
  asosEmitidos     ASO[]
}

// ==================== COLABORADORES E ESTRUTURA ====================

model Setor {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funcoes       Funcao[]
  ghes          GHE[]
  colaboradores Colaborador[]
}

model Funcao {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  cbo       String?
  setor     Setor    @relation(fields: [setorId], references: [id], onDelete: Cascade)
  setorId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colaboradores Colaborador[]
  riscos        RiscoFuncao[]
}

model Colaborador {
  id             String    @id @default(cuid())
  nome           String
  cpf            String
  dataNascimento DateTime?
  sexo           String?
  email          String?
  telefone       String?
  dataAdmissao   DateTime?
  dataDemissao   DateTime?
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String
  setor     Setor?  @relation(fields: [setorId], references: [id])
  setorId   String?
  funcao    Funcao? @relation(fields: [funcaoId], references: [id])
  funcaoId  String?

  solicitacoesExame        SolicitacaoExame[]
  asos                     ASO[]
  treinamentosParticipante TreinamentoParticipante[]

  @@unique([empresaId, cpf])
}

// ==================== RISCOS E GHE ====================

enum TipoRisco {
  FISICO
  QUIMICO
  BIOLOGICO
  ERGONOMICO
  ACIDENTE
  PSICOSSOCIAL
}

enum NivelRisco {
  BAIXO
  MEDIO
  ALTO
  MUITO_ALTO
}

model Risco {
  id               String    @id @default(cuid())
  nome             String
  tipo             TipoRisco
  descricao        String?
  fonteGeradora    String?
  possiveisAgravos String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  funcoes         RiscoFuncao[]
  ghes            RiscoGHE[]
  inventarioItens InventarioRiscoItem[]
  examesPCMSO     ExamePCMSO[]
}

model RiscoFuncao {
  id                String      @id @default(cuid())
  risco             Risco       @relation(fields: [riscoId], references: [id], onDelete: Cascade)
  riscoId           String
  funcao            Funcao      @relation(fields: [funcaoId], references: [id], onDelete: Cascade)
  funcaoId          String
  nivelRisco        NivelRisco?
  probabilidade     Int?
  severidade        Int?
  medidasExistentes String?

  @@unique([riscoId, funcaoId])
}

model GHE {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  setor     Setor    @relation(fields: [setorId], references: [id], onDelete: Cascade)
  setorId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riscos RiscoGHE[]
}

model RiscoGHE {
  id            String      @id @default(cuid())
  ghe           GHE         @relation(fields: [gheId], references: [id], onDelete: Cascade)
  gheId         String
  risco         Risco       @relation(fields: [riscoId], references: [id], onDelete: Cascade)
  riscoId       String
  nivelRisco    NivelRisco?
  probabilidade Int?
  severidade    Int?

  @@unique([gheId, riscoId])
}

// ==================== PGR ====================

enum StatusDocumento {
  RASCUNHO
  EM_REVISAO
  APROVADO
  VENCIDO
}

model PGR {
  id                      String          @id @default(cuid())
  titulo                  String
  versao                  String          @default("1.0")
  dataElaboracao          DateTime        @default(now())
  dataRevisao             DateTime?
  status                  StatusDocumento @default(RASCUNHO)
  elaboradorNome          String?
  elaboradorRegistro      String?
  observacoes             String?
  caracterizacaoProcessos String?
  metodologiaAvaliacao    String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId       String
  inventarioItens InventarioRiscoItem[]
  planoAcaoItens  PlanoAcaoItem[]
  pcmso           PCMSO?
}

model InventarioRiscoItem {
  id                               String      @id @default(cuid())
  pgr                              PGR         @relation(fields: [pgrId], references: [id], onDelete: Cascade)
  pgrId                            String
  risco                            Risco       @relation(fields: [riscoId], references: [id])
  riscoId                          String
  setorNome                        String?
  funcaoNome                       String?
  gheNome                          String?
  fonteGeradora                    String?
  numeroExpostos                   Int?
  tipoExposicao                    String?
  probabilidade                    Int?
  severidade                       Int?
  nivelRisco                       NivelRisco?
  medidasExistentes                String?
  necessidadeAvaliacaoQuantitativa Boolean     @default(false)
  resultadoAvaliacao               String?
  observacoes                      String?
  createdAt                        DateTime    @default(now())
  updatedAt                        DateTime    @updatedAt
}

model PlanoAcaoItem {
  id               String    @id @default(cuid())
  pgr              PGR       @relation(fields: [pgrId], references: [id], onDelete: Cascade)
  pgrId            String
  descricaoAcao    String
  riscoRelacionado String?
  responsavel      String?
  prazo            DateTime?
  status           String    @default("Pendente")
  prioridade       String?
  observacoes      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ==================== PCMSO ====================

model PCMSO {
  id              String          @id @default(cuid())
  titulo          String
  versao          String          @default("1.0")
  dataElaboracao  DateTime        @default(now())
  dataRevisao     DateTime?
  status          StatusDocumento @default(RASCUNHO)
  objetivos       String?
  diretrizes      String?
  responsavelNome String?
  responsavelCrm  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId           String
  pgr                 PGR?     @relation(fields: [pgrId], references: [id])
  pgrId               String?  @unique
  medicoCoordenador   Medico?  @relation("MedicoCoordenador", fields: [medicoCoordenadorId], references: [id])
  medicoCoordenadorId String?
  exames              ExamePCMSO[]
}

model ExamePCMSO {
  id                     String   @id @default(cuid())
  pcmso                  PCMSO    @relation(fields: [pcmsoId], references: [id], onDelete: Cascade)
  pcmsoId                String
  nomeExame              String
  tipo                   String
  periodicidade          String?
  risco                  Risco?   @relation(fields: [riscoId], references: [id])
  riscoId                String?
  setoresAplicaveis      String?
  funcoesAplicaveis      String?
  criteriosInterpretacao String?
  observacoes            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ==================== FLUXO DE EXAMES E ASO ====================

enum StatusSolicitacao {
  PENDENTE
  ENVIADA_CLINICA
  EM_ATENDIMENTO
  ASO_EMITIDO
  CANCELADA
}

model SolicitacaoExame {
  id                String            @id @default(cuid())
  tipoExame         String
  status            StatusSolicitacao @default(PENDENTE)
  dataSolicitacao   DateTime          @default(now())
  dataAgendamento   DateTime?
  observacoes       String?
  riscosInformados  String?
  examesSolicitados String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  empresa       Empresa     @relation(fields: [empresaId], references: [id])
  empresaId     String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  colaboradorId String
  clinica       Clinica?    @relation(fields: [clinicaId], references: [id])
  clinicaId     String?
  aso           ASO?
}

model ASO {
  id                    String    @id @default(cuid())
  numero                String?
  dataEmissao           DateTime  @default(now())
  dataExame             DateTime?
  razaoSocialEmpresa    String
  cnpjEmpresa           String
  nomeColaborador       String
  cpfColaborador        String
  funcaoColaborador     String?
  riscosOcupacionais    String?
  examesRealizados      String?
  conclusao             String
  restricoes            String?
  medicoNome            String?
  medicoCrm             String?
  medicoCrmUf           String?
  medicoCoordNome       String?
  medicoCoordCrm        String?
  arquivoUrl            String?
  observacoes           String?
  checklistPsicossocial String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  solicitacao   SolicitacaoExame @relation(fields: [solicitacaoId], references: [id])
  solicitacaoId String           @unique
  colaborador   Colaborador      @relation(fields: [colaboradorId], references: [id])
  colaboradorId String
  clinica       Clinica          @relation(fields: [clinicaId], references: [id])
  clinicaId     String
  medico        Medico?          @relation(fields: [medicoId], references: [id])
  medicoId      String?
}

// ==================== TREINAMENTOS / DDS ====================

model Treinamento {
  id             String    @id @default(cuid())
  titulo         String
  tipo           String    // NR-06, NR-10, DDS, Integração, etc.
  cargaHoraria   Int?
  dataRealizacao DateTime?
  validade       DateTime?
  instrutor      String?
  local          String?
  conteudo       String?
  observacoes    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  empresa       Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  participantes TreinamentoParticipante[]
}

model TreinamentoParticipante {
  id            String   @id @default(cuid())
  presente      Boolean  @default(true)
  nota          String?
  certificado   String?
  createdAt     DateTime @default(now())

  treinamento   Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  treinamentoId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  colaboradorId String

  @@unique([treinamentoId, colaboradorId])
}
