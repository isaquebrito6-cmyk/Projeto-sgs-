# Postgres (Neon ou Vercel Postgres) — OBRIGATÓRIO em produção
# Preferir connection Direct (sem -pooler) + ?sslmode=require
# Não use channel_binding=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

